# ESP32-S3 target
CONFIG_IDF_TARGET="esp32s3"

# Flash size (DevKitC-1 N8R8 = 8MB flash, but our boards have 16MB)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Custom partition table (3MB app + 960KB data)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# USB Host support
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=512

# WiFi
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# LwIP — phones open many simultaneous connections during captive portal detection
CONFIG_LWIP_MAX_SOCKETS=16

# Stack sizes for blocking I/O
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# Stack overflow detection (hardware watchpoint at end of stack)
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# Heap — disable memory protection for full PSRAM access
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n

# HTTP server WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y

# mDNS
CONFIG_MDNS_MAX_SERVICES=4

# TLS — certificate bundle for HTTPS (GitHub Pages downloads)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
